# Copy to .env and change every value before deploying.
#
#   cp .env.example .env
#
# .env is gitignored - never commit real credentials.

# --- database -------------------------------------------------------------
POSTGRES_USER=pocketbase
POSTGRES_DB=pocketbase

# CHANGE THIS - the app refuses to start while it is the value below.
# Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-please

# --- application ----------------------------------------------------------
# OPTIONAL. Leave empty to store settings unencrypted, which is what upstream
# PocketBase does by default.
#
# When set it must be exactly 32 characters and encrypts the stored SMTP and S3
# credentials at rest. Keep it safe: losing it makes those settings unreadable.
# Generate one with:  openssl rand -base64 24 | cut -c1-32
#
# The app refuses to start if this is left as the example value.
PB_ENCRYPTION_KEY=

# host port for the dashboard and API
PB_PORT=8090

# image tag to deploy; pin a release (eg. v0.39.10-pg.1) rather than tracking
# "latest", so a restart cannot silently move you to a new version
PB_IMAGE_TAG=latest

# --- resource limits ------------------------------------------------------
# Caps, not reservations. They stop a runaway container taking the host down;
# they do not set anything aside. Too low and the kernel OOM-kills the process,
# so raise them on a busy instance rather than trimming them blindly.
PB_CPU_LIMIT=1.0
PB_MEM_LIMIT=512m
PG_CPU_LIMIT=1.0
PG_MEM_LIMIT=1g

# --- file ownership -------------------------------------------------------
# The uid:gid the app runs as. It must own the bind-mounted pb_data, pb_hooks,
# pb_migrations and pb_public directories, or the server cannot write to them.
#
# Set these to your own user:   id -u   and   id -g
# Leaving them unset uses the image's built-in "pb" user (101:102), which only
# works if those directories are owned by 101:102 on the host.
PB_UID=
PB_GID=
