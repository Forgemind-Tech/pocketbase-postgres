# Copy to .env and change every value before deploying.
#
#   cp .env.example .env
#
# .env is gitignored - never commit real credentials.

# --- database -------------------------------------------------------------
POSTGRES_USER=pocketbase
POSTGRES_DB=pocketbase

# CHANGE THIS. The database is not published to the host, but this is still
# the only thing protecting it from anything else on the compose network.
POSTGRES_PASSWORD=change-me-please

# --- application ----------------------------------------------------------
# CHANGE THIS. Must be exactly 32 characters. Encrypts stored settings (SMTP
# and S3 credentials) at rest. Losing it makes those settings unreadable.
PB_ENCRYPTION_KEY=change-me-32-characters-long-000

# host port for the dashboard and API
PB_PORT=8090

# image tag to deploy; pin a release (eg. v0.39.10-pg.1) rather than tracking
# "latest", so a restart cannot silently move you to a new version
PB_IMAGE_TAG=latest
