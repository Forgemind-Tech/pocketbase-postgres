# Runtime-only image used by goreleaser, which supplies an already-compiled
# binary in the build context rather than building from source.
#
# The runtime stage is intentionally identical to the one in ./Dockerfile - keep
# them in sync. They are separate files because ./Dockerfile builds from source
# (useful locally), while this one must not, or every release would compile the
# binary twice.
#
# Based on the Postgres image to obtain pg_dump/psql at exactly the server's
# major version; the backup feature shells out to them and pg_dump refuses to
# dump a server newer than itself. See ./Dockerfile for why a plain Alpine base
# does not work.
FROM postgres:18-alpine

RUN addgroup -S pb && adduser -S -G pb pb \
    && mkdir -p /pb_data && chown pb:pb /pb_data

# supplied by goreleaser in the build context
COPY pocketbase /usr/local/bin/pocketbase

# the shim applies the flags every invocation needs and refuses to start on the
# example credentials; see docker/entrypoint.sh
COPY docker/entrypoint.sh /usr/local/bin/pb
RUN chmod +x /usr/local/bin/pb

USER pb
WORKDIR /pb_data
EXPOSE 8090

# ENTRYPOINT is the shim rather than the binary, so that "docker compose exec
# pocketbase pb ..." and the server itself get identical flags
ENTRYPOINT ["/usr/local/bin/pb"]
CMD ["serve", "--http=0.0.0.0:8090"]
